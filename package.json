{
  "name": "petsmetrics",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest",
    "test:e2e": "playwright test",
    "risk-check": "node scripts/risk-check.mjs",
    "verify-geo": "node scripts/verify-geo-ssg.mjs",
    "check-cross-species-diff": "node scripts/check-cross-species-diff.mjs",
    "check-eu-uniqueness": "node scripts/check-eu-uniqueness.mjs",
    "check-breed-page-dimensions": "node scripts/check-breed-page-dimensions.mjs",
    "precheck": "pnpm build && pnpm risk-check && pnpm verify-geo"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "next": "^14.2.0",
    "next-intl": "^3.15.0",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.0",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
